# Variabile de mediu — Platformă BAC
# Copiază acest fișier în `.env.local` și completează valorile reale.
# NICIODATĂ nu comite `.env.local` în Git.
#
# Variabilele sunt validate la pornirea serverului (lib/env.ts). Dacă lipsește
# una obligatorie, serverul crapă imediat cu mesaj clar. Adaugi o variabilă nouă?
# Actualizează și schema din lib/env.ts.

# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adresa directa a bazei de date, folosita DOAR de unelte, la aplicarea migrarilor
# (`npm run db:plan` / `npm run db:push`). Contine parola bazei.
#
# Aplicatia NU o foloseste si nu trebuie pusa pe Vercel — de aceea nu e nici in
# schema din lib/env.ts. Daca ar fi acolo ca obligatorie, deployul ar crapa.
#
# De unde: panoul Supabase -> Connect -> Connection string -> Session pooler.
# Daca parola contine caractere speciale, ele trebuie codate procentual in adresa.
SUPABASE_DB_URL=

# ─── Clerk (autentificare) ───────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Numele noi (Clerk v7). AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL sunt deprecate si ignorate.
# "Fallback" = se aplica doar cand nu exista alta destinatie; daca vii dintr-o pagina
# anume, Clerk se intoarce acolo. Redirectul garantat catre /dashboard e facut cu
# forceRedirectUrl, direct in paginile de sign-in/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── Stripe (plăți) ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=

# ─── Panou de monitorizare (/admin) ─────────────────────────
# Email-uri cu acces la /admin, separate prin virgula.
ADMIN_EMAILS=
# Token Vercel pentru deploy-uri + loguri (vercel.com/account/tokens).
VERCEL_API_TOKEN=
# Optional: doar daca proiectul e intr-o echipa Vercel (nu cont personal).
VERCEL_TEAM_ID=
# Optional: numele proiectului Vercel (default: platforma-bac).
VERCEL_PROJECT_NAME=

# ─── Monitorizare / alerte ──────────────────────────────────
# URL webhook Discord pentru alerte instant la erori critice (webhook plata,
# checkout esuat). Optional — daca lipseste, erorile doar se logeaza in DB.
# Creezi: Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_ALERT_WEBHOOK_URL=

# ─── Aplicație ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LanguageTool self-hostat, pentru ortografie si punctuatie la corectarea automata.
# Optional: daca lipseste, criteriile de limba raman nenotate (nu primesc 0).
# Ex. local: docker run -d -p 8010:8010 erikvl87/languagetool
LANGUAGETOOL_URL=

# ─── Email tranzacțional (Resend) ────────────────────────────
# Opționale. Fără RESEND_API_KEY nu se trimite niciun email, iar aplicația
# funcționează normal — notificarea de tichet e pur și simplu sărită.
#
# ATENȚIE: domeniul din EMAIL_FROM trebuie VERIFICAT în Resend (DNS: SPF + DKIM).
# Cu un domeniu neverificat, Resend acceptă trimiterea doar către adresa
# proprietarului contului — ar merge la tine în test și ar tăcea pentru elevi.
RESEND_API_KEY=
EMAIL_FROM=Platforma BAC <noreply@exemplu.ro>
