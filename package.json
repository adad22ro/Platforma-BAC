{
  "name": "platforma-bac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks",
    "db:types": "npx -y supabase@latest gen types typescript --linked --schema public > types/database.ts",
    "debug": "node --env-file=.env.local scripts/debug.mjs",
    "seed:content": "node --env-file=.env.local scripts/seed-content.mjs",
    "seed:questions": "node --env-file=.env.local scripts/seed-questions.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.22",
    "@stripe/stripe-js": "^9.12.0",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.3.2",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
