{
  "name": "platforma-bac",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "git config core.hooksPath .githooks",
    "db:plan": "node scripts/db-push.mjs --plan",
    "db:push": "node scripts/db-push.mjs",
    "db:types": "npx -y supabase@latest gen types typescript --linked --schema public > types/database.ts",
    "debug": "node --env-file=.env.local scripts/debug.mjs",
    "seed:content": "node --env-file=.env.local scripts/seed-content.mjs",
    "seed:questions": "node --env-file=.env.local scripts/seed-questions.mjs",
    "barem:check": "vitest run tests/barem.test.ts",
    "barem:import": "node --env-file=.env.local scripts/import-barem.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@stripe/stripe-js": "^9.16.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
