# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase CLI: fisierele locale (.temp/.branches/env) sunt ignorate de
# supabase/.gitignore (generat de `supabase init`). config.toml + migrations/
# se comit (config versionat, fara secrete).

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

.flaskenv*
!.env.project
!.env.vault
# pre-push: jurnalul ultimei rulari a hook-ului (util la depanarea esecurilor)
.githooks/last-run.log
.githooks/last-failure.log
.githooks/.last-status

# documentatie generata (docdash) — artefact local, nu sursa
/doc/

# Instructiuni generate de extensia SonarQube din VS Code. Nu sunt fisier de
# echipa: le genereaza extensia fiecaruia, si nu toti o folosim. Au intrat o data
# din greseala printr-un `git add -A` (bc746a3) — de aici regula, ca sa nu se
# repete. Daca vreodata vrem instructiuni comune de analiza, se scriu de mana si
# se comit explicit.
/.github/instructions/
